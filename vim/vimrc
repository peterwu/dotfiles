def Highlight(group: string, fg='NONE', bg='NONE', style='NONE'): void
    final style_dict = {}

    for v in style->split(',')
        style_dict[v] = true
    endfor

    hlset([{
        name:    group,
        ctermfg: fg,
        ctermbg: bg,
        cterm:   style_dict,
        guifg:   fg,
        guibg:   bg,
        gui:     style_dict
    }])
enddef

